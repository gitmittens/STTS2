      {
        "when": "bamboo",
        "model": { "type": "minecraft:model", "model": "stts:item/hoe/bamboo_hoe" }
      },
      {
        "when": "crimson",
        "model": { "type": "minecraft:model", "model": "stts:item/hoe/crimson_hoe" }
      },
      {
        "when": "warped",
        "model": { "type": "minecraft:model", "model": "stts:item/hoe/warped_hoe" }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/wooden_hoe"
    }
  }
